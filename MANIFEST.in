include LICENSE README.md CHANGELOG.md CONTRIBUTING.md PRIVACY.md SECURITY.md THIRD_PARTY_NOTICES.md
include requirements.lock uv.lock plugin.json mcp.json package.json package-lock.json .gitignore
include .agents/plugins/marketplace.json
recursive-include cache_monitor *.py *.html
recursive-include ui *.js *.css *.html
recursive-include assets *.svg
recursive-include scripts *.py *.mjs *.ps1 *.sh
recursive-include tests *.py *.mjs
recursive-include docs *.md
recursive-include docs/screenshots *.png
recursive-include skills SKILL.md
recursive-include .github/workflows *.yml
prune .monitor
prune .codex
prune .venv
prune node_modules
prune .release-test
